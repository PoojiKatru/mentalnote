---
import Layout from '../layouts/Layout.astro';
import NoteCard from '../components/NoteCard.astro';
import ThemeCalendar from '../components/ThemeCalendar.astro';
import { getCollection } from 'astro:content';
import { formatDay } from '../lib/format';

const themes = await getCollection('themes');
const open = themes.find((t) => t.data.status === 'open')!;

// Seed notes for the open theme (kept honestly labelled as seed — brief §19.7).
const seedNotes = (await getCollection('notes'))
  .filter((n) => n.data.source === 'seed' && n.data.theme === open.data.name)
  .slice(0, 2);
---
<Layout title="This week · Mental Note" active="this-week">
<div class="month phead-dark"><div class="wrap">
  <div class="eyebrow">Week of {formatDay(open.data.startDate)}</div>
  <h2>{open.data.name}.</h2>
  <p class="lead">{open.data.prompt}</p>
  <div class="mgrid">
    {/*
      Privacy separation (brief §4 / §19.3): the note and the optional email must
      reach SEPARATE destinations with no shared row. They are two independent
      Netlify forms. The email <input> is associated to the "subscribe" form via
      its form="subscribe" attribute, so the note form's "Send it" submits the
      note ONLY — the email is never in the same submission. Honeypots, no CAPTCHA
      (brief §11). Fallback if the co-founder prefers: swap the subscribe form for
      a Tally embed; nothing else changes.
    */}
    <form class="compose" name="note" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="note" />
      <p hidden><label>Leave this empty: <input name="bot-field" /></label></p>
      <label for="n">Your note</label>
      <textarea id="n" name="note" placeholder="Dear me, one year from now…" required></textarea>
      <div class="optin">
        <label for="e">Want the articles and events? <span>Optional</span></label>
        <input id="e" type="email" name="email" form="subscribe" placeholder="your@email.com" />
        <small>Stored separately. Never attached to your note, and we'll never link the two.</small>
      </div>
      <div class="crow"><small>Your note is anonymous. Read by us before anything is published.</small><button class="send" type="submit">Send it</button></div>
    </form>
    <form id="subscribe" name="subscribe" method="POST" data-netlify="true" netlify-honeypot="company" hidden>
      <input type="hidden" name="form-name" value="subscribe" />
      <p hidden><label>Leave this empty: <input name="company" /></label></p>
      <button type="submit" tabindex="-1" aria-hidden="true">Subscribe</button>
    </form>
    <div class="stk">
      {seedNotes.map((n) => <NoteCard body={n.data.body} ageLabel={n.data.ageLabel} />)}
      <div class="cnt"><span class="stat">Seed notes · written by us</span><br>The wall fills up as people send theirs in.</div>
    </div>
  </div>
</div></div>

<div class="light"><div class="block"><div class="wrap rv">
  <div class="eyebrow">The weeks ahead</div>
  <h2>A new theme every week.</h2>
  <p class="lead">Each theme runs for a week across the notes, the articles, the Instagram questions, and the check-in.</p>
  <ThemeCalendar />
  <p class="cnt2">Past weeks stay in the archive. Nothing gets deleted.</p>
</div></div></div>
</Layout>
