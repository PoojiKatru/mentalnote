---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** nav key for the active page; omit on the homepage */
  active?: string;
}
// Mission line is an open content item (brief §20) — placeholder default.
const {
  title,
  description = 'Teen mental health, peer-led — placeholder mission line, under fifteen words.',
  active,
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#1C1424" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <!-- Failsafe: if JS never runs, reveal-on-scroll sections must not stay hidden. -->
  <noscript><style>.rv{opacity:1 !important;transform:none !important}</style></noscript>
</head>
<body>
  <div class="grain" aria-hidden="true"></div>
  <a class="sos" href="/support#help"><b>Need help now</b>Call or text 988</a>
  <button class="exit" data-quick-exit type="button" aria-label="Leave this site immediately">Leave this site</button>
  <Header active={active} />
  <slot />
  <Footer />

  <!-- External + same-origin so the strict CSP (script-src 'self') allows it.
       An inline script would be CSP-blocked, which hides every reveal section
       and disables the quick exit. Keep this external; do not inline it. -->
  <script type="module" src="/site.js" is:inline></script>
</body>
</html>
