---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** nav key for the active page; omit on the homepage */
  active?: string;
}
// Mission line is an open content item (brief §20) — placeholder default.
const {
  title,
  description = 'Teen mental health, peer-led — placeholder mission line, under fifteen words.',
  active,
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#1C1424" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
</head>
<body>
  <div class="grain" aria-hidden="true"></div>
  <a class="sos" href="/support#help"><b>Need help now</b>Call or text 988</a>
  <button class="exit" data-quick-exit type="button" aria-label="Leave this site immediately">Leave this site</button>
  <Header active={active} />
  <slot />
  <Footer />

  <script>
    // Quick exit (brief §10a): replace() leaves no back-button trail, and the
    // new blank tab moves focus off this page. Also bound to Escape pressed
    // twice. This is a real DV-safety requirement, not a nicety.
    function quickExit() {
      window.open('about:blank', '_blank');
      window.location.replace('https://www.google.com/search?q=weather');
    }
    document
      .querySelectorAll('[data-quick-exit]')
      .forEach((b) => b.addEventListener('click', quickExit));

    let esc = 0;
    let escT: ReturnType<typeof setTimeout>;
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      esc++;
      clearTimeout(escT);
      escT = setTimeout(() => (esc = 0), 700);
      if (esc >= 2) quickExit();
    });

    // Reveal-on-scroll — the only ambient JS in the design.
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    document.querySelectorAll('.rv').forEach((el) => io.observe(el));
  </script>
</body>
</html>
